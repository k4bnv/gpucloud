# Copy this file to .env and fill in your own values.
#
# Any variable left unset (or empty) falls back to the default already
# baked into the code/data — nothing breaks if you only fill in some of
# these.
#
# Read at build time (astro dev / astro build), so these get baked into
# the generated static HTML — there is no runtime lookup in the browser.

# Production domain — sitemap.xml, canonical URLs and OG/Twitter tags all
# key off this. Falls back to "https://gpucompare.cloud" if unset — only
# set this if you're deploying to a different domain.
SITE_URL=https://gpucompare.cloud

# Real affiliate/referral links. Convention: AFFILIATE_URL_<SLUG>,
# provider slug uppercased with hyphens as underscores (see
# src/data/providers.json's "slug" field for each provider). Any left
# unset here fall back to the "?ref=AFFILIATE_ID" placeholder already
# committed in providers.json.
AFFILIATE_URL_RUNPOD=https://runpod.io/?ref=YOUR_ID
AFFILIATE_URL_VAST_AI=https://vast.ai/?ref=YOUR_ID
AFFILIATE_URL_HYPERSTACK=https://console.hyperstack.cloud/?ref=YOUR_ID
AFFILIATE_URL_PAPERSPACE=https://www.paperspace.com/?ref=YOUR_ID
AFFILIATE_URL_NOVITA_AI=https://novita.ai/?ref=YOUR_ID
AFFILIATE_URL_THUNDER_COMPUTE=https://www.thundercompute.com/?ref=YOUR_ID
AFFILIATE_URL_CLOUDRIFT=https://cloudrift.ai/?ref=YOUR_ID
AFFILIATE_URL_JARVISLABS=https://jarvislabs.ai/?ref=YOUR_ID
AFFILIATE_URL_HOTAISLE=https://hotaisle.xyz/?ref=YOUR_ID
AFFILIATE_URL_VERDA=https://verda.com/?ref=YOUR_ID

# API keys that enable live price fetching for providers that require
# auth even for public catalog data. Unset = that provider's fetcher
# skips itself (not an error) and keeps the last committed price.
RUNPOD_API_KEY=
HYPERSTACK_API_KEY=
THUNDER_API_KEY=
# JarvisLabs and Hot Aisle are fetched via the gpuhunt Python subprocess
# (see README.md's "Live price sync" section) — requires `pip install -r
# scripts/gpuhunt/requirements.txt` too, not just these keys.
JARVISLABS_API_KEY=
# Hot Aisle needs both of these (AMD MI300X/MI355X only, no NVIDIA).
HOTAISLE_API_KEY=
HOTAISLE_TEAM_HANDLE=
# Verda (formerly DataCrunch) needs both of these — OAuth-style client
# credentials from the Verda dashboard, not a single API key.
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=

# Comma-separated list of your own real off-site profile URLs (LinkedIn
# company page, GitHub org, X/Twitter, etc.), used as `sameAs` in the
# Organization JSON-LD schema on every page. This is how Google/AI crawlers
# link "this website" to "this LinkedIn page" as the same entity. Only put
# real, owned URLs here — never a placeholder or a page you don't control.
# Unset = sameAs is simply omitted (not a broken/empty value).
SOCIAL_URLS=
